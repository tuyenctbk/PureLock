<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Enforce zero-cloud storage for PureLock encrypted database and Keystore-wrapped passphrase -->
        <exclude domain="database" path="purelock_privacy_encrypted.db" />
        <exclude domain="database" path="purelock_privacy_encrypted.db-wal" />
        <exclude domain="database" path="purelock_privacy_encrypted.db-shm" />
        <exclude domain="sharedpref" path="purelock_sec_vault.xml" />
        <exclude domain="sharedpref" path="pure_lock_checksum_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Android Keystore TEE keys are hardware-bound and non-transferable -->
        <exclude domain="database" path="purelock_privacy_encrypted.db" />
        <exclude domain="database" path="purelock_privacy_encrypted.db-wal" />
        <exclude domain="database" path="purelock_privacy_encrypted.db-shm" />
        <exclude domain="sharedpref" path="purelock_sec_vault.xml" />
        <exclude domain="sharedpref" path="pure_lock_checksum_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
