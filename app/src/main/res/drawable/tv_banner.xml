    <!-- Top Right Corner Sci-Fi Accent -->
    <path
        android:strokeColor="#00F0FF"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.5"
        android:pathData="M270,15 L305,15 L305,50" />
</vector>
