<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Background Obsidian/Sapphire Gradient -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:color="#FF090D16" android:offset="0.0" />
                <item android:color="#FF0F172A" android:offset="0.5" />
                <item android:color="#FF0369A1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Futuristic Cyber Grid Lines -->
    <path
        android:strokeColor="#1E293B"
        android:strokeWidth="1"
        android:strokeAlpha="0.6"
        android:pathData="M0,30 L320,30 M0,60 L320,60 M0,90 L320,90 M0,120 L320,120 M0,150 L320,150" />
    <path
        android:strokeColor="#1E293B"
        android:strokeWidth="1"
        android:strokeAlpha="0.6"
        android:pathData="M40,0 L40,180 M80,0 L80,180 M120,0 L120,180 M160,0 L160,180 M200,0 L200,180 M240,0 L240,180 M280,0 L280,180" />

    <!-- Ambient Glowing Radial Halo Behind Shield -->
    <path android:pathData="M60,90 m-65,0 a65,65 0 1,0 130,0 a65,65 0 1,0 -130,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="90"
                android:gradientRadius="65"
                android:type="radial">
                <item android:color="#4D00F0FF" android:offset="0.0" />
                <item android:color="#1A0072FF" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shield & Lock Emblem (Centered around X=60, Y=90) -->
    <group
        android:pivotX="60"
        android:pivotY="90"
        android:scaleX="1.15"
        android:scaleY="1.15">

        <!-- Outer Glowing Shield Border -->
        <path android:pathData="M60,54 C48,60 36,62 32,68 C32,92 40,110 60,118 C80,110 88,92 88,68 C84,62 72,60 60,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="60"
                    android:startY="54"
                    android:endX="60"
                    android:endY="118"
                    android:type="linear">
                    <item android:color="#FF00F0FF" android:offset="0.0" />
                    <item android:color="#FF2EB5FF" android:offset="0.5" />
                    <item android:color="#FF0052D4" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Dark Shield Cavity -->
        <path
            android:fillColor="#0B1120"
            android:pathData="M60,57 C50,62 40,64 36,69 C36,90 43,106 60,114 C77,106 84,90 84,69 C80,64 70,62 60,57 Z" />

        <!-- Biometric Fingerprint Rings Motif inside Shield -->
        <path
            android:strokeColor="#38BDF8"
            android:strokeWidth="1.8"
            android:strokeAlpha="0.85"
            android:strokeLineCap="round"
            android:pathData="M60,66 C55,66 51,70 51,75 M60,62 C53,62 47,67 47,75 C47,82 50,88 60,94 M60,70 C57,70 55,72 55,75 M60,78 C59,78 58,79 58,81" />

        <!-- Lock Shackle -->
        <path
            android:fillColor="#00F0FF"
            android:fillType="evenOdd"
            android:pathData="M60,70 C56,70 53,73 53,77 V81 H56 V77 C56,74.5 57.5,73 60,73 C62.5,73 64,74.5 64,77 V81 H67 V77 C67,73 64,70 60,70 Z" />

        <!-- Lock Body -->
        <path
            android:fillColor="#E2E8F0"
            android:pathData="M51,81 H69 C70.5,81 72,82.5 72,84 V96 C72,97.5 70.5,99 69,99 H51 C49.5,99 48,97.5 48,96 V84 C48,82.5 49.5,81 51,81 Z" />

        <!-- Keyhole -->
        <path
            android:fillColor="#0B1120"
            android:pathData="M60,86 C61.1,86 62,86.9 62,88 C62,88.7 61.6,89.3 61,89.7 L61.5,93 H58.5 L59,89.7 C58.4,89.3 58,88.7 58,88 C58,86.9 58.9,86 60,86 Z" />
    </group>

    <!-- TV Leanback Text Brand & Badges -->
    <group android:translateX="130" android:translateY="50">
