            android:pathData="M15,8 H27 C31,8 34,10.5 34,14 C34,17.5 31,20 27,20 H20 V26 H15 V8 Z M20,12 V16 H26 C28,16 29,15.2 29,14 C29,12.8 28,12 26,12 H20 Z" />
