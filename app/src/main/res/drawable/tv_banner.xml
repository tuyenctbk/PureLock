            android:fillColor="#00F0FF"
            android:pathData="M106,8 H111 V22 H121 V26 H106 V8 Z" />
        <!-- O -->
        <path
            android:fillColor="#00F0FF"
            android:pathData="M124,8 H136 C141,8 144,11.5 144,17 C144,22.5 141,26 136,26 H124 C119,26 116,22.5 116,17 C116,11.5 119,8 124,8 Z M124,12 C122,12 121,13.8 121,17 C121,20.2 122,22 124,22 H136 C138,22 139,20.2 139,17 C139,13.8 138,12 136,12 H124 Z" />
