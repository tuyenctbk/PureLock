        <path
            android:fillColor="#1E293B"
            android:pathData="M15,48 H145 C148,48 150,50 150,53 V63 C150,66 148,68 145,68 H15 C12,68 10,66 10,63 V53 C10,50 12,48 15,48 Z" />
        <path
            android:fillColor="#10B981"
            android:pathData="M18,58 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
