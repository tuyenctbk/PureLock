        android:pathData="M60,26 C46,32 34,34 30,40 C30,66 39,85 60,94 C81,85 90,66 90,40 C86,34 74,32 60,26 Z" />

    <path
        android:strokeColor="#10B981"
        android:strokeWidth="2.5"
        android:pathData="M60,28 C48,34 36,36 32,41 C32,64 41,82 60,91 C79,82 88,64 88,41 C84,36 72,34 60,28 Z" />

    <!-- Verified Checkmark -->
    <path
        android:strokeColor="#10B981"
        android:strokeWidth="4"
