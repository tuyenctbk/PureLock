    <!-- Greenish Safe Ambient Halo -->
    <path android:pathData="M60,60 m-48,0 a48,48 0 1,0 96,0 a48,48 0 1,0 -96,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="60"
                android:centerY="60"
                android:gradientRadius="48"
                android:type="radial">
                <item android:color="#2610B981" android:offset="0.0" />
