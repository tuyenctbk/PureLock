<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="120dp"
    android:viewportWidth="360"
    android:viewportHeight="120">

    <!-- Subtle Deep Card Gradient Background -->
    <path android:pathData="M0,0 L360,0 L360,120 L0,120 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="360"
                android:endY="120"
                android:type="linear">
                <item android:color="#FF0F172A" android:offset="0.0" />
                <item android:color="#FF1E293B" android:offset="0.5" />
                <item android:color="#FF0B132B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Cyber Grid Pattern -->
    <path
        android:strokeColor="#334155"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.4"
        android:pathData="M0,24 L360,24 M0,48 L360,48 M0,72 L360,72 M0,96 L360,96" />
    <path
        android:strokeColor="#334155"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.4"
        android:pathData="M40,0 L40,120 M80,0 L80,120 M120,0 L120,120 M160,0 L160,120 M200,0 L200,120 M240,0 L240,120 M280,0 L280,120 M320,0 L320,120" />

    <!-- Ambient Cyan Glow Radial -->
    <path android:pathData="M300,60 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="300"
                android:centerY="60"
                android:gradientRadius="50"
                android:type="radial">
                <item android:color="#4000F0FF" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Futuristic Cyber Shield Icon (Right Side X=300, Y=60) -->
    <group
        android:pivotX="300"
        android:pivotY="60"
        android:scaleX="0.85"
        android:scaleY="0.85">

        <!-- Outer Shield Border -->
        <path android:pathData="M300,25 C286,31 274,33 270,39 C270,64 278,82 300,90 C322,82 330,64 330,39 C326,33 314,31 300,25 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="300"
                    android:startY="25"
                    android:endX="300"
                    android:endY="90"
                    android:type="linear">
                    <item android:color="#FF00F0FF" android:offset="0.0" />
                    <item android:color="#FF0284C7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:fillColor="#0B1120"
            android:pathData="M300,28 C288,33 278,35 274,40 C274,62 281,78 300,86 C319,78 326,62 326,40 C322,35 312,33 300,28 Z" />

        <!-- Glowing Checkmark / Lock Inside Shield -->
        <path
            android:strokeColor="#00F0FF"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M288,58 L296,66 L312,48" />
    </group>

    <!-- Circuit Trace Lines Leading to Shield -->
    <path
        android:strokeColor="#00F0FF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.6"
        android:strokeLineCap="round"
        android:pathData="M180,40 L230,40 L255,55 M140,80 L220,80 L250,68" />
    <path
        android:fillColor="#00F0FF"
        android:pathData="M180,40 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
    <path
        android:fillColor="#00F0FF"
        android:pathData="M140,80 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
</vector>
